# ==============================================================================
# Enterprise HRM Platform - Environment Configuration & Seed Accounts
# ==============================================================================

# Application Environment
NODE_ENV=development
VITE_API_BASE_URL=/api

# Gmail SMTP for the local email server (never expose these as VITE_* values)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@tarvinoinnovis.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=admin@tarvinoinnovis.com
EMAIL_SERVER_PORT=8787

# JWT & Authentication Secrets (Change in Production)
JWT_SECRET=dev-insecure-hrm-jwt-secret-do-not-use-in-production-12345
JWT_EXPIRATION_HOURS=24

# Database Configuration (PostgreSQL in Production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrm_enterprise_db
DB_USER=postgres
DB_PASSWORD=replace_with_secure_password_in_production

